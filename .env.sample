# Names only. Copy into ui/.env and ui/rte/.env and fill in (dev-app-initial-setup also generates them).
# URL where the custom field page is served
REACT_APP_CUSTOM_FIELD_URL=
# JSON map of Contentstack regions to their JSON RTE extension URLs
REACT_APP_REGION_MAPPING=
# Base URL of your DAM integration API, if any
REACT_APP_API_URL=
# API key sent to your DAM integration API, if any
REACT_APP_API_KEY=
# Maximum number of configurations the config screen allows
REACT_APP_MULTI_CONFIG_LIMIT=
# scripts/ only: set to collect links for open-collected-links
COLLECT_LINKS=
